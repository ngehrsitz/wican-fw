# ESP32-EVB Rev K: use a separate generated SDKCONFIG, never the root C3 file.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Match upstream WiCAN: its CAN tasks use 1 ms waits and delays.
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="wican_partitions_table.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_RMII_CLK_INPUT=y
CONFIG_ETH_RMII_CLK_IN_GPIO=0
# BLE is not used on this profile; its public functions are no-op stubs.
# CONFIG_BT_ENABLED is not set
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Match the existing project's warning policy; unrelated legacy code is retained.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
